-- 0 set_add: add to tags
cql:     UPDATE payments.transactions_by_merchant SET tags = tags + ? WHERE merchant_id = ? AND txn_day = ? AND txn_time = ?;
preview: UPDATE payments.transactions_by_merchant SET tags = tags + {'vip', 'eu'} WHERE merchant_id = 7c9e6679-7425-40de-944b-e07fc1f90ae7 AND txn_day = '2026-09-30' AND txn_time = 3f1a2b10-9d3c-11ef-8a6e-0242ac120002;
args:    []interface {}([vip eu]) gocql.UUID(7c9e6679-7425-40de-944b-e07fc1f90ae7) time.Time(2026-09-30 00:00:00 +0000 UTC) gocql.UUID(3f1a2b10-9d3c-11ef-8a6e-0242ac120002)

